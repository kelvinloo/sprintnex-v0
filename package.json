{
  "name": "@different-ai/sprintnex-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "SPRINTNEX_DEV_MODE=1 SPRINTNEX_ELECTRON_REMOTE_DEBUG_PORT=${SPRINTNEX_ELECTRON_REMOTE_DEBUG_PORT:-9823} pnpm --filter @sprintnex/desktop dev",
    "dev:electron": "SPRINTNEX_DEV_MODE=1 pnpm --filter @sprintnex/desktop dev:electron",
    "dev:sandbox": "bash .devcontainer/dev-sandbox.sh",
    "dev:ui": "SPRINTNEX_DEV_MODE=1 pnpm --filter @sprintnex/app dev",
    "dev:ui-demo": "pnpm --filter @sprintnex/ui-demo dev",
    "email:dev": "pnpm --filter @sprintnex/email dev",
    "dev:headless-web": "SPRINTNEX_DEV_MODE=1 bun scripts/dev-headless-web.ts",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --filter @sprintnex/app build",
    "preview": "pnpm --filter @sprintnex/app preview",
    "typecheck": "pnpm --filter @sprintnex/app typecheck",
    "check:enterprise-mcp-mock-server": "pnpm --filter @sprintnex/enterprise-mcp-mock-server check",
    "test:health": "pnpm --filter @sprintnex/app test:health",
    "test:sessions": "pnpm --filter @sprintnex/app test:sessions",
    "test:refactor": "pnpm --filter @sprintnex/app test:refactor",
    "test:events": "pnpm --filter @sprintnex/app test:events",
    "test:todos": "pnpm --filter @sprintnex/app test:todos",
    "test:permissions": "pnpm --filter @sprintnex/app test:permissions",
    "test:session-error-recovery": "pnpm --filter @sprintnex/app test:session-error-recovery",
    "test:session-scope": "pnpm --filter @sprintnex/app test:session-scope",
    "test:session-switch": "pnpm --filter @sprintnex/app test:session-switch",
    "test:fs-engine": "pnpm --filter @sprintnex/app test:fs-engine",
    "test:e2e": "pnpm --filter @sprintnex/app test:e2e",
    "evals": "node evals/runner/run.mjs",
    "fraimz": "node evals/runner/run.mjs",
    "test:orchestrator": "pnpm --filter sprintnex-orchestrator test:router",
    "bump:patch": "pnpm --filter @sprintnex/app bump:patch",
    "bump:minor": "pnpm --filter @sprintnex/app bump:minor",
    "bump:major": "pnpm --filter @sprintnex/app bump:major",
    "bump:set": "pnpm --filter @sprintnex/app bump:set",
    "release:review": "node scripts/release/review.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:prepare:dry": "node scripts/release/prepare.mjs --dry-run",
    "release:ship": "node scripts/release/ship.mjs",
    "release:ship:watch": "node scripts/release/ship.mjs --watch"
  },
  "devDependencies": {
    "turbo": "^2.5.5"
  },
  "packageManager": "pnpm@11.4.0"
}
